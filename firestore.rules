rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Educational resource portal collections
    match /users/{userId} {
      allow read, write: if true;
    }
    match /folders/{folderId} {
      allow read, write: if true;
    }
    match /files/{fileId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    match /file_chunks/{chunkId} {
      allow read, write: if true;
    }
    match /test_conn/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
